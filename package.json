{
  "name": "pieces-cabinet-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Démo : pièces reçues, lues par l'IA, pré-saisies au plan SYSCOHADA puis exportées.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
